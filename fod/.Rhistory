# librairies
library(ncdf4)
library(rpart)
library(rpart.plot)
library(splines)
library(fda)
library(zoo)
rm(list = ls())
path = "/run/media/mmolinet/DATA1/data/raw/temperature_salinite/cmems_mod_glo_phy_my_0.083deg_P1D-m_thetao-so_40.00E-95.00E_60.00S-20.00S_0.49-5727.92m_2021-01-09-2021-03-03.nc"
ds <- nc_open(path)
thetao <- ncvar_get(ds, "thetao") # (lon, lat, depth, time)
so <- ncvar_get(ds, "so") # (lon, lat, depth, time)
depth <- ncvar_get(ds, "depth")
# libérer esoace mémoire
rm(ds)
gc()
i_500m <- which.min(abs(depth - 500))
thetao_500m <- thetao[,,1:i_500m,]
so_500m <- so[,,1:i_500m,]
depth_500m <- depth[1:i_500m]
# libérer esoace mémoire
rm(thetao, so, depth)
gc()
# -------------- applatir les mats de temp et sal
dim_ds <- dim(thetao_500m)
lon   <- dim_ds[1]
lat   <- dim_ds[2]
depth   <- dim_ds[3]
time   <- dim_ds[4]
thetao_500_flat <- matrix(
thetao_500m,
nrow = lon* lat * time,
ncol = depth,
byrow = TRUE
)
so_500_flat <- matrix(
so_500m,
nrow = lon* lat * time,
ncol = depth,
byrow = TRUE
)
rm(thetao_500m, so_500m)
ds_concat <- rbind(thetao_500_flat, so_500_flat)
rm(thetao_500_flat, so_500_flat)
gc()
# --------------- gestion des nans
# 1. retirer les profils qui ont + de 20% de nans
NA_count <- rowSums(is.na(ds_concat))
ratio_NA <- NA_count / ncol(ds_concat)
mask <- ratio_NA < 0.2
ds_concat <- ds_concat[mask, ]
rm (NA_count, ration_NA,  mask)
gc()
system.time({
test <- t(apply(ds_concat[1:1000, ], 1, function(x) {
approx(
x = depth_500m[!is.na(x)],
y = x[!is.na(x)],
xout = depth_500m,
rule = 2
)$y
}))
})
install.packages("pbapply")
